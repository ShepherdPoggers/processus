{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Déboguer le shell (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/shell",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Activer l’affichage des objets C++",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Compiler le shell (debug)"
        }
    ]
}
